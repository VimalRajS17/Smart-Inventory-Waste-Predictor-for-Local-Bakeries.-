# ==============================================================================
# Loaf Ledger - Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and customize values for your deployment environment.

# ------------------------------------------------------------------------------
# 1. Database & Persistence Configuration
# ------------------------------------------------------------------------------
# Default SQLite database file path.
# IMPORTANT: On cloud container platforms with ephemeral filesystems (e.g., Render,
# Railway, Fly.io), ensure this points to a persistent disk mount (e.g. /data/bakery.db
# or /var/data/bakery.db). Otherwise, data will be lost on container redeployments.
DATABASE_PATH=bakery.db

# Alternative: PostgreSQL / Standard Database URL (optional).
# If set, Loaf Ledger uses this connection URL (e.g., postgresql://user:pass@host:5432/loafledger
# or sqlite:///path/to/bakery.db).
# DATABASE_URL=sqlite:///bakery.db

# ------------------------------------------------------------------------------
# 2. Flask & Security Settings
# ------------------------------------------------------------------------------
# Secret key used for cryptographic session signing and CSRF tokens.
# IN PRODUCTION: Generate a secure random string (e.g., `python -c "import secrets; print(secrets.token_hex(32))"`).
SECRET_KEY=dev-secret-key-change-in-production

# Debug mode: 0 (disabled, recommended for production) or 1 (enabled for local development).
FLASK_DEBUG=0

# Web server listening port (used by Gunicorn or local development server).
PORT=5000

# ------------------------------------------------------------------------------
# 3. Location, Weather & Regional Settings
# ------------------------------------------------------------------------------
# Default coordinates for weather forecasts via Open-Meteo API.
# (Defaults to Central London: 51.5074, -0.1278).
DEFAULT_LAT=51.5074
DEFAULT_LON=-0.1278

# Country code used by the `holidays` Python package for official bank holiday detection.
HOLIDAY_COUNTRY=UK

# Precipitation threshold in mm to classify a day as rainy (default: 1.0 mm).
RAIN_THRESHOLD_MM=1.0

# ------------------------------------------------------------------------------
# 4. Background Scheduler & Model Retraining
# ------------------------------------------------------------------------------
# Toggle APScheduler nightly retrain job (1=enabled, 0=disabled). Default: 1.
RETRAIN_SCHEDULE_ENABLED=1

# Retraining run time (24-hour UTC format). Default: 02:30 AM UTC.
RETRAIN_SCHEDULE_HOUR=2
RETRAIN_SCHEDULE_MINUTE=30

# ------------------------------------------------------------------------------
# 5. Reinforcement Learning Contextual Bandit (Phase 4D)
# ------------------------------------------------------------------------------
# Set to 'true' to enable the contextual bandit safety multiplier layer. Default: false.
RL_ENABLED=false

# ------------------------------------------------------------------------------
# 6. Demo Account Credentials (Used for seed-demo and reset-demo CLI commands)
# ------------------------------------------------------------------------------
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo123
